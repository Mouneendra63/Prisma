datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User{
  id Int @id @default(autoincrement())
  email String @unique
  name String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Client{
  id Int @id @default(autoincrement())
  name String
  email String
  phone String
  address String
  createdAt DateTime @default(now())
}